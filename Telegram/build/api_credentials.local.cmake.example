# Copy to api_credentials.local.cmake (ignored by VCS) and replace both
# placeholders with values from https://my.telegram.org/apps. The ID is a
# positive integer; the hash is 32 lowercase hexadecimal digits.
# Configure local login builds with -D TDESKTOP_API_TEST=OFF.
# IKK_API_ID / IKK_API_HASH environment variables take precedence.
set(IKK_API_ID 0)
set(IKK_API_HASH "")
